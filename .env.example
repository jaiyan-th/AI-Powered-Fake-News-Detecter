# =============================================================================
# AI NEWS VERIFICATION SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================

# --- LLM INFERENCE (GROQ) ---
# Get free API key at: https://console.groq.com
GROQ_API_KEY=

# --- REAL-TIME NEWS & WEB SEARCH ---
# Get free API key at: https://newsapi.org (100 req/day)
NEWS_API_KEY=

# Optional: Get free API key at: https://serpapi.com (100 searches/month)
SERPAPI_KEY=


# --- EMBEDDINGS (FastEmbed) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- SERVER CONFIGURATION ---
PORT=8000
HOST=0.0.0.0
DEBUG=false
PRODUCTION=false
# DATABASE_DIR=/path/to/persistent/data
# CORS_ORIGINS=["https://frontend.example.com"]

# Required with PRODUCTION=true. Keep the same value across deployments.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=
